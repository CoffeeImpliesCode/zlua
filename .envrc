export DIRENV_WARN_TIMEOUT=20s

# Establish owned local .devenv/.direnv links before any CLI evaluation.
# Keep original values in exported markers across host-wrapper scratch defaults.
watch_file tools/setup-env.sh
source ./tools/setup-env.sh || return 1
zlua_capture_caller
zlua_setup "$PWD" || return 1

if [ -x "$HOME/.local/bin/devenv" ]; then
  # Both direnvrc generation and its `use devenv` command use the host wrapper.
  PATH_add "$HOME/.local/bin"
  _zlua_direnvrc=$("$HOME/.local/bin/devenv" direnvrc) || return 1
else
  _zlua_direnvrc=$(devenv direnvrc) || return 1
fi
eval "$_zlua_direnvrc" || return 1
unset _zlua_direnvrc
use devenv "${zlua_devenv_options[@]}" || return 1
unset zlua_devenv_options
